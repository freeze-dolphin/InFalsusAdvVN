<Project Sdk="Microsoft.NET.Sdk">

  <!--
    InFalsusAdvVN - visual-novel language hot-swap mod for "In Falsus" (IL2CPP).
    Build:  dotnet build -c Release
    Output: bin\Release\InFalsusAdvVN.dll + Thunderstore layout under BepInEx\plugins\InFalsusAdvVN\
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>InFalsusAdvVN</AssemblyName>
    <RootNamespace>InFalsusAdvVN</RootNamespace>
    <Version>1.0.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <NoWarn>$(NoWarn);CS0436;CS0169</NoWarn>
  </PropertyGroup>

  <!-- Location of the BepInEx IL2CPP install used for compilation. Override with /p:BepInExDir=... -->
  <PropertyGroup>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(APPDATA)\r2modmanPlus-local\InFalsus\profiles\Default\BepInEx</BepInExDir>
    <InteropDir>$(BepInExDir)\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 (be.788) core + Il2CppInterop runtime -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExDir)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game interop assemblies generated by Il2CppInterop -->
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(InteropDir)\Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(InteropDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(InteropDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(InteropDir)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Str"><HintPath>$(InteropDir)\Str.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Game.NovelEngine"><HintPath>$(InteropDir)\Game.NovelEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Game"><HintPath>$(InteropDir)\Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Game.Data"><HintPath>$(InteropDir)\Game.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Game.Input"><HintPath>$(InteropDir)\Game.Input.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FastText"><HintPath>$(InteropDir)\FastText.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copy the built plugin into the Thunderstore package layout after a successful build -->
  <Target Name="PackagePlugin" AfterTargets="Build">
    <MakeDir Directories="BepInEx\plugins\InFalsusAdvVN" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="BepInEx\plugins\InFalsusAdvVN" />
    <Message Importance="high" Text="InFalsusAdvVN built: $(TargetPath)" />
  </Target>

</Project>
